# Server Configuration
PORT=3001
NODE_ENV=development

# Set to 'production' for Render deployment:
# NODE_ENV=production

# CORS - comma-separated allowed origins
# In production with same-origin serving, this can be left empty or set to your Render URL.
CORS_ORIGINS=http://localhost:5173

# Database
# Default: ./data/workshop.db
# On Render, mount a persistent disk and set this to the mount path, e.g.:
# DB_PATH=/var/data/workshop.db
DB_PATH=./data/workshop.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
REGISTRATION_RATE_LIMIT_MAX=10

# Admin Bootstrap Credentials (Used only during initial `npm run admin:bootstrap`)
# NEVER use these defaults in production — set strong unique values.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_strong_password_8chars
