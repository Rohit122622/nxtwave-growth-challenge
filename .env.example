# Server Configuration
PORT=3001
NODE_ENV=development

# Render Free Deployment Configuration:
# NODE_ENV=production

# CORS - Comma-separated allowed origins (Optional on Render Free)
# When the React frontend is served by Express (same-origin), this can be left empty
# or set to your Render service URL (e.g. https://your-service.onrender.com).
CORS_ORIGINS=http://localhost:5173

# Database Path
# Local Development: ./data/workshop.db
# Render Free (Ephemeral Container /tmp directory):
# DB_PATH=/tmp/workshop.db
DB_PATH=./data/workshop.db

# Rate Limiting & Proxy Trust
# TRUST_PROXY: Number of trusted reverse-proxy hops. Default is 1 for Render.
# Narrowly scopes proxy trust to 1 hop, preventing IP spoofing while enabling accurate rate limiting.
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
REGISTRATION_RATE_LIMIT_MAX=10

# Admin Bootstrap Credentials
# On Render Free, these variables securely initialize the administrator account
# during server startup ONLY IF no administrator account exists in the database.
# Never commit real credentials — use strong unique credentials in your Render dashboard.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_strong_password_8chars
